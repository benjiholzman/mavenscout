<mxfile host="app.diagrams.net"><diagram name="El flujo dentro de los jobs" id="d1"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1480" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;El flujo dentro de los jobs&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="400" height="30" as="geometry"/></mxCell><mxCell id="lg0" value="App, ya construida" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="40" width="300" height="28" as="geometry"/></mxCell><mxCell id="lg1" value="Motor, por construir" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="74" width="300" height="28" as="geometry"/></mxCell><mxCell id="lg2" value="Llamada LLM en Bedrock" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="108" width="300" height="28" as="geometry"/></mxCell><mxCell id="lg3" value="Almacén de datos" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f3ea;strokeColor=#1f8a57;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="900" y="142" width="300" height="28" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;1. Pegar la descripción del puesto (JD)&lt;/b&gt;&lt;br&gt;El gerente la pega y pulsa Read job description" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="360" height="60" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;2. Job: extract&lt;/b&gt;&lt;br&gt;Una llamada a Sonnet 5.5 lee la JD una sola vez. Devuelve sugerencias validadas contra un esquema: expertise, lugares, idiomas, organización. Nunca marca Must have&lt;br&gt;&lt;i&gt;unos $0.02 por JD&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="360" height="120" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;3. Definir prioridades&lt;/b&gt;&lt;br&gt;El gerente fija cada fila: Nice to have, Important o Must have" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="360" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;4. Filtro Must have&lt;/b&gt;&lt;br&gt;Hoy corre en la app (TypeScript, en el navegador). Al motor solo se envían los ids de los perfiles que pasan" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="360" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;5. Job: rank. Etapa 1, preselección por significado&lt;/b&gt;&lt;br&gt;Se convierte la consulta en embedding y se hace una búsqueda k-NN en OpenSearch sobre los fragmentos de perfil del grupo. Un perfil vale lo que su mejor fragmento&lt;br&gt;&lt;i&gt;casi $0 por búsqueda&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="360" height="120" as="geometry"/></mxCell><mxCell id="d6" value="¿Similitud sobre el&lt;br&gt;umbral absoluto?&lt;br&gt;(tope de 200)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#8a6a12;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="680" width="360" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;6. Etapa 2: Fit con un LLM&lt;/b&gt;&lt;br&gt;Haiku 5.5 lee los 5 fragmentos más relevantes. Devuelve Fit de 0 a 100 y componentes. Reintenta con espera creciente. Si aun así falla, el candidato usa el Fit estimado y queda marcado&lt;br&gt;&lt;i&gt;unos $0.00034 por candidato&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="820" width="360" height="130" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Fit estimado&lt;/b&gt;&lt;br&gt;Se calcula desde la similitud, con tope bajo. Se marca como no evaluado a fondo&lt;br&gt;&lt;i&gt;casi $0&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="240" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;7. Puntos de preferencias y total&lt;/b&gt;&lt;br&gt;Código existente de la app (adjustments.ts, total.ts), reutilizado dentro del worker&lt;br&gt;Total = (1 - w) x Fit + 100 x w x ganados / posibles" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="990" width="360" height="90" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;8. Banda y orden&lt;/b&gt;&lt;br&gt;Strong 80+, Good 65 a 79, Partial 50 a 64, Weak menos de 50. Empates: Fit, disponibilidad, id de perfil" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="1120" width="360" height="70" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;9. Narrativa de unas 100 palabras&lt;/b&gt;&lt;br&gt;Sonnet 5.5, solo el top 20, con los números finales como entrada. Si falla, se usa la narrativa de plantilla y se marca&lt;br&gt;&lt;i&gt;unos $0.0055 cada una&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="1230" width="360" height="90" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;10. Guardar y mostrar&lt;/b&gt;&lt;br&gt;El resultado va a S3. El navegador lo descarga, lo guarda con el código existente y muestra las tarjetas ordenadas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f3ea;strokeColor=#1f8a57;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="1360" width="360" height="80" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;El gerente relaja un Must have&lt;/b&gt;&lt;br&gt;Solo los candidatos recién elegibles pasan por los pasos 5 a 9 y se fusionan. Los puntajes no cambian, porque ninguno depende del grupo" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="900" y="530" width="320" height="100" as="geometry"/></mxCell><mxCell id="e_n1_n2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n2_n3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n3_n4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n4_n5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n5_d6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="d6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n7_n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n9_n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n10_n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n11_n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d6_n7" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d6_n8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d6" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n8_n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n12_n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_n13_n5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n13" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>