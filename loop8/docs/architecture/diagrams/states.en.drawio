<mxfile host="app.diagrams.net"><diagram name="Job states and what moves a job between them" id="d1"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="660" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Job states and what moves a job between them&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="700" height="30" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;QUEUED&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="180" height="60" as="geometry"/></mxCell><mxCell id="r" value="&lt;b&gt;RUNNING&lt;/b&gt;&lt;br&gt;The worker runs the pipeline, writes progress and saves a checkpoint after each candidate" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="360" y="130" width="240" height="210" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;DONE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f3ea;strokeColor=#1f8a57;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="180" height="44" as="geometry"/></mxCell><mxCell id="p" value="&lt;b&gt;PARTIAL&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#8a6a12;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="213" width="180" height="44" as="geometry"/></mxCell><mxCell id="f" value="&lt;b&gt;FAILED&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8e3df;strokeColor=#b14a35;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="276" width="180" height="44" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;Continuation&lt;/b&gt;&lt;br&gt;Time budget ending: save checkpoint and re-enqueue" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="360" y="400" width="160" height="100" as="geometry"/></mxCell><mxCell id="note" value="After 5 failed deliveries SQS moves the message to the dead-letter queue, an alarm fires and the job is marked FAILED. CANCELLED is set by the user, and the worker checks it between batches." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1020" height="70" as="geometry"/></mxCell><mxCell id="e1" value="worker picks the job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.476;entryDx=0;entryDy=0;" edge="1" parent="1" source="q" target="r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="all scored" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r" target="d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="some fell back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r" target="p"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="retries exhausted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="time budget ending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=0.333;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="re-enqueue, same jobId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c" target="q"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="crash or timeout: SQS redelivers after the visibility timeout (up to 5 times)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="r" target="q"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="75"/><mxPoint x="130" y="75"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>