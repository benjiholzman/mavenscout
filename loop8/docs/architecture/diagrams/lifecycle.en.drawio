<mxfile host="app.diagrams.net"><diagram name="Request lifecycle: how a call travels" id="d1"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="1230" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Request lifecycle: how a call travels&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="500" height="30" as="geometry"/></mxCell><mxCell id="l1" value="&lt;b&gt;1. The manager clicks Read job description or Rank&lt;/b&gt;&lt;br&gt;The app wrapper creates a requestId (UUID)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="380" height="60" as="geometry"/></mxCell><mxCell id="l2" value="&lt;b&gt;2. POST /jobs&lt;/b&gt;&lt;br&gt;{requestId, kind, payload}. The pool goes as ids, not full profiles" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="380" height="60" as="geometry"/></mxCell><mxCell id="d3" value="Valid and under&lt;br&gt;the daily cap?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#8a6a12;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="235" width="380" height="90" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;400 or 429&lt;/b&gt; with a clear message. No job is created" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="800" y="250" width="300" height="60" as="geometry"/></mxCell><mxCell id="d4" value="requestId already&lt;br&gt;seen?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#8a6a12;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="365" width="380" height="90" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Return the existing jobId.&lt;/b&gt; No second job and no second charge" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="800" y="380" width="300" height="60" as="geometry"/></mxCell><mxCell id="d4b" value="Same inputs already&lt;br&gt;scored?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#8a6a12;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="495" width="380" height="90" as="geometry"/></mxCell><mxCell id="r4b" value="&lt;b&gt;Return the stored result.&lt;/b&gt; No new work and no new cost" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="800" y="510" width="300" height="60" as="geometry"/></mxCell><mxCell id="l5" value="&lt;b&gt;3. Save the input to S3,&lt;/b&gt; create the job as QUEUED in DynamoDB, send the jobId to SQS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="625" width="380" height="80" as="geometry"/></mxCell><mxCell id="l6" value="&lt;b&gt;4. Return 202 with the jobId&lt;/b&gt;&lt;br&gt;Under 1 second" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="740" width="380" height="50" as="geometry"/></mxCell><mxCell id="l7" value="&lt;b&gt;5. Poll GET /jobs/{id}&lt;/b&gt;&lt;br&gt;1 s growing to 5 s. The jobId is kept in sessionStorage, so a reload resumes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="825" width="380" height="80" as="geometry"/></mxCell><mxCell id="d8" value="Status?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#8a6a12;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="940" width="380" height="90" as="geometry"/></mxCell><mxCell id="l9" value="&lt;b&gt;6. Download the result&lt;/b&gt; with a presigned S3 URL and pass it to the existing UI code. PARTIAL shows a notice" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f3ea;strokeColor=#1f8a57;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="330" y="1075" width="380" height="80" as="geometry"/></mxCell><mxCell id="r10" value="&lt;b&gt;Show the error&lt;/b&gt; and offer Retry or the labeled placeholder ranking" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="20" y="950" width="240" height="70" as="geometry"/></mxCell><mxCell id="n11" value="After 3 minutes without a result the app says it is still working and lets the user keep waiting or cancel" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="240" height="90" as="geometry"/></mxCell><mxCell id="e_l1_l2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l2_d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l5_l6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l6_l7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l6" target="l7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l7_d8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l7" target="d8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d3_d4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d3_r3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d4_r4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d4_d4b" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d4" target="d4b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d4b_r4b" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4b" target="r4b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d4b_l5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d4b" target="l5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d8_l9" value="DONE or PARTIAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d8" target="l9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d8_r10" value="FAILED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="r10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_d8_l7" value="RUNNING: keep polling" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="l7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="985"/><mxPoint x="1000" y="865"/></Array></mxGeometry></mxCell><mxCell id="e_n11_l7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n11" target="l7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>