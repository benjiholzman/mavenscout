<mxfile host="app.diagrams.net"><diagram name="Asynchronous architecture on AWS" id="d1"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="880" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Asynchronous architecture on AWS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="500" height="28" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Manager&#x27;s browser&lt;/b&gt;&lt;br&gt;Existing React app. A thin client wrapper keeps the two function signatures: submit, poll, resume, time out" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="180" height="130" as="geometry"/></mxCell><mxCell id="aws" value="AWS, MavenScout account, us-east-1. Every resource carries the aws-apn-id tag" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;verticalAlign=top;fontStyle=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="880" height="760" as="geometry"/></mxCell><mxCell id="apigw" value="&lt;b&gt;API Gateway (HTTP API)&lt;/b&gt;&lt;br&gt;CORS and throttling. POST /jobs and GET /jobs/{id}" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="125" width="170" height="80" as="geometry"/></mxCell><mxCell id="lapi" value="&lt;b&gt;Lambda: api&lt;/b&gt;&lt;br&gt;Validates, checks idempotency and stored results, creates the job, returns 202. The status route returns progress and a result link" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="520" y="125" width="200" height="80" as="geometry"/></mxCell><mxCell id="sqs" value="&lt;b&gt;SQS: jobs&lt;/b&gt;&lt;br&gt;Caps concurrent jobs and redelivers after a crash" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f3ea;strokeColor=#1f8a57;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="780" y="125" width="150" height="80" as="geometry"/></mxCell><mxCell id="dlq" value="&lt;b&gt;Dead-letter queue&lt;/b&gt;&lt;br&gt;After 5 failed receives, with an alarm" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="980" y="125" width="140" height="80" as="geometry"/></mxCell><mxCell id="orch" value="Lambda: worker (orchestrator)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="270" width="300" height="330" as="geometry"/></mxCell><mxCell id="s1" value="extract: JD to requirements" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="535" y="315" width="270" height="42" as="geometry"/></mxCell><mxCell id="s2" value="retrieve: embed and k-NN search" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="535" y="365" width="270" height="42" as="geometry"/></mxCell><mxCell id="s3" value="fit: bounded parallel calls, retries, checkpoints" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="535" y="415" width="270" height="42" as="geometry"/></mxCell><mxCell id="s4" value="score: existing code (adjustments, total, bands)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="535" y="465" width="270" height="42" as="geometry"/></mxCell><mxCell id="s5" value="narrate: top 20, fallback to template" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="535" y="515" width="270" height="42" as="geometry"/></mxCell><mxCell id="ddb" value="&lt;b&gt;DynamoDB: jobs&lt;/b&gt;&lt;br&gt;State, progress, checkpoints, idempotency keys, stored results index, TTL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f3ea;strokeColor=#1f8a57;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="290" width="170" height="100" as="geometry"/></mxCell><mxCell id="s3b" value="&lt;b&gt;S3: payloads&lt;/b&gt;&lt;br&gt;Inputs and results. Private, expire in 7 days" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f3ea;strokeColor=#1f8a57;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="430" width="170" height="90" as="geometry"/></mxCell><mxCell id="bed" value="Amazon Bedrock (inference profiles)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="220" height="250" as="geometry"/></mxCell><mxCell id="m1" value="Claude Sonnet 5.5: extraction and narratives" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="912" y="315" width="196" height="52" as="geometry"/></mxCell><mxCell id="m2" value="Claude Haiku 5.5: Fit per candidate" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="912" y="377" width="196" height="52" as="geometry"/></mxCell><mxCell id="m3" value="Titan Text Embeddings V2: vectors" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="912" y="439" width="196" height="52" as="geometry"/></mxCell><mxCell id="os" value="&lt;b&gt;OpenSearch Serverless&lt;/b&gt;&lt;br&gt;Vector search over profile fragments, filtered to the pool ids" style="rounded=1;ar