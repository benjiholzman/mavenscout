<mxfile host="app.diagrams.net"><diagram name="Dónde se ahorra el costo: el embudo" id="d1"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="640" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Dónde se ahorra el costo: el embudo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="600" height="30" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b&gt;Directorio&lt;/b&gt;&lt;br&gt;unos 3,000 perfiles individuales" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3f3ea;strokeColor=#1f8a57;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="200" y="56" width="720" height="72" as="geometry"/></mxCell><mxCell id="c0" value="&lt;b&gt;unos 3,000&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="150" height="72" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Filtro Must have (en la app)&lt;/b&gt;&lt;br&gt;costo $0, el tamaño depende de las filas del gerente" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="260" y="148" width="600" height="72" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;hasta 3,000&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="20" y="148" width="150" height="72" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Etapa 1: búsqueda k-NN en OpenSearch&lt;/b&gt;&lt;br&gt;conserva los perfiles sobre el umbral, máximo 200. costo casi $0 por búsqueda" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="240" width="480" height="72" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;100 a 200&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="150" height="72" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Etapa 2: Fit con LLM (Haiku 5.5)&lt;/b&gt;&lt;br&gt;unos $0.03 a $0.07" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="380" y="332" width="360" height="72" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;100 a 200 llamadas&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="20" y="332" width="150" height="72" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Narrativa del top 20 (Sonnet 5.5)&lt;/b&gt;&lt;br&gt;unos $0.11" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="440" y="424" width="240" height="72" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;20 llamadas&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="20" y="424" width="150" height="72" as="geometry"/></mxCell><mxCell id="tot" value="Ranking completo con los modelos recomendados: unos $0.19 con reintentos y procesamiento solo en EE. UU. Solo Haiku: unos $0.05. Mandar los 3,000 perfiles a Haiku 5.5 sin etapa 1: unos $1.13, pero más lento y más exigente con los límites de tasa" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="60" y="526" width="860" height="70" as="geometry"/></mxCell><mxCell id="note" value="&lt;i&gt;Los precios son de la lista oficial de precios de AWS. Los tamaños de tokens son estimados, no medidos&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="60" y="606" width="860" height="24" as="geometry"/></mxCell><mxCell id="fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r0" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>