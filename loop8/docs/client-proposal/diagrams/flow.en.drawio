<mxfile host="app.diagrams.net"><diagram name="What happens in one search" id="d1"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="1190" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;What happens in one search&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="600" height="28" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#194e63;strokeColor=#194e63;fontColor=#121722;fontSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="44" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="215" y="44" width="44" height="24" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="390" y="44" width="44" height="24" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#8a6a12;fontColor=#121722;fontSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="565" y="42" width="40" height="28" as="geometry"/></mxCell><mxCell id="lg4" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=1;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="740" y="44" width="44" height="24" as="geometry"/></mxCell><mxCell id="lt0" value="Start or end" style="text;html=1;whiteSpace=wrap;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="90" y="36" width="120" height="44" as="geometry"/></mxCell><mxCell id="lt1" value="Step that already exists in the app" style="text;html=1;whiteSpace=wrap;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="265" y="36" width="120" height="44" as="geometry"/></mxCell><mxCell id="lt2" value="New step that uses AI" style="text;html=1;whiteSpace=wrap;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="440" y="36" width="120" height="44" as="geometry"/></mxCell><mxCell id="lt3" value="Decision. The arrows say Yes or No" style="text;html=1;whiteSpace=wrap;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="615" y="36" width="120" height="44" as="geometry"/></mxCell><mxCell id="lt4" value="Estimated cost and AI model of the step" style="text;html=1;whiteSpace=wrap;fontSize=10.5;align=left;verticalAlign=middle;fontColor=#121722;" vertex="1" parent="1"><mxGeometry x="790" y="36" width="120" height="44" as="geometry"/></mxCell><mxCell id="rail" value="&lt;i&gt;Estimated cost and AI model of each step (Sonnet and Haiku, recommended)&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="250" height="40" as="geometry"/></mxCell><mxCell id="S" value="Start: a hiring manager opens a ranking" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#194e63;strokeColor=#194e63;fontColor=#121722;fontSize=12;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="112" width="280" height="44" as="geometry"/></mxCell><mxCell id="D1" value="Is a job description pasted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#8a6a12;fontColor=#121722;fontSize=12.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="280" y="174" width="380" height="80" as="geometry"/></mxCell><mxCell id="N1" value="&lt;b&gt;The AI reads the job description&lt;/b&gt;&lt;br&gt;and suggests requirements. It never marks anything as required" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=12.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="310" y="272" width="320" height="70" as="geometry"/></mxCell><mxCell id="N2" value="&lt;b&gt;The manager sets priorities&lt;/b&gt;&lt;br&gt;Must have, Important or Nice to have. Seniority and location are set here" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="310" y="360" width="320" height="64" as="geometry"/></mxCell><mxCell id="D2" value="Does the consultant meet every Must have?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#8a6a12;fontColor=#121722;fontSize=12.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="280" y="442" width="380" height="80" as="geometry"/></mxCell><mxCell id="D3" value="Does the experience closely match in meaning?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#8a6a12;fontColor=#121722;fontSize=12.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="280" y="540" width="380" height="96" as="geometry"/></mxCell><mxCell id="N4" value="&lt;b&gt;The AI reviews the best profiles&lt;/b&gt;&lt;br&gt;100 to 200 of them. Each gets a score from 0 to 100, with a breakdown by technical skills, domain expertise, and sector and regional experience" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=12.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="310" y="654" width="320" height="88" as="geometry"/></mxCell><mxCell id="N5" value="&lt;b&gt;Your rules produce the final result&lt;/b&gt;&lt;br&gt;The AI score and the manager&#x27;s priorities combine into a final score and match level" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef1f3;strokeColor=#5b6774;fontColor=#121722;fontSize=12.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="310" y="760" width="320" height="92" as="geometry"/></mxCell><mxCell id="N6" value="&lt;b&gt;The AI writes a short explanation&lt;/b&gt;&lt;br&gt;of about 100 words for each top candidate" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#efe6f5;strokeColor=#7a4fa0;fontColor=#121722;fontSize=12.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="310" y="870" width="320" height="68" as="geometry"/></mxCell><mxCell id="E" value="End: the ranked list is shown, with scores and explanations" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#194e63;strokeColor=#194e63;fontColor=#121722;fontSize=11.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="956" width="300" height="44" as="geometry"/></mxCell><mxCell id="R1" value="The app ranks by the manager&#x27;s priorities only, as it does today. No AI is used" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="710" y="181.0" width="190" height="66" as="geometry"/></mxCell><mxCell id="R2" value="The consultant is removed and is not scored" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="710" y="458.0" width="190" height="48" as="geometry"/></mxCell><mxCell id="R3" value="The consultant gets a basic score and appears lower in the list, with a note" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="710" y="552.0" width="190" height="72" as="geometry"/></mxCell><mxCell id="T1" value="&lt;b&gt;about $0.024&lt;/b&gt;&lt;br&gt;Claude Sonnet 5.5" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=11.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="287.0" width="190" height="40" as="geometry"/></mxCell><mxCell id="p_T1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#c9711a;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="T1" target="N1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="T3" value="&lt;b&gt;about $0&lt;/b&gt;&lt;br&gt;Titan V2 and search database" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=11.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="568.0" width="190" height="40" as="geometry"/></mxCell><mxCell id="p_T3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#c9711a;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="T3" target="D3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="T4" value="&lt;b&gt;about $0.034&lt;/b&gt;&lt;br&gt;Claude Haiku 5.5" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=11.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="678.0" width="190" height="40" as="geometry"/></mxCell><mxCell id="p_T4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#c9711a;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="T4" target="N4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="T6" value="&lt;b&gt;about $0.11&lt;/b&gt;&lt;br&gt;Claude Sonnet 5.5" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#fbeedd;strokeColor=#c9711a;fontColor=#121722;fontSize=11.5;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="884.0" width="190" height="40" as="geometry"/></mxCell><mxCell id="p_T6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#c9711a;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="T6" target="N6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S" target="D1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="D1" target="N1"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="f3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D1" target="R1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="R1" target="E"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="918" y="214.0"/><mxPoint x="918" y="978.0"/></Array></mxGeometry></mxCell><mxCell id="f5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="N1" target="N2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="N2" target="D2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="D2" target="D3"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="f8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D2" target="R2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="f9" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="D3" target="N4"><mxGeometry relative="1" as="geometry"><mxPoint x="20" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="f10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D3" target="R3"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="R3" target="N5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="806.0"/></Array></mxGeometry></mxCell><mxCell id="f12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="N4" target="N5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="N5" target="N6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b6774;strokeWidth=1.5;fontSize=11;fontColor=#121722;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="N6" target="E"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="TOT" value="&lt;b&gt;Estimated total cost of one search&lt;/b&gt;&lt;br&gt;Steps above: about $0.17. Retries and supporting AWS services: about $0.02&lt;br&gt;&lt;b&gt;Sonnet and Haiku (recommended): about $0.19, likely range $0.09 to $0.56&lt;/b&gt;&lt;br&gt;Haiku only: about $0.05. Sonnet only: about $0.90" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b6774;fontColor=#121722;fontSize=13;strokeWidth=2.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;strokeColor=#194e63;" vertex="1" parent="1"><mxGeometry x="150" y="1030" width="640" height="104" as="geometry"/></mxCell><mxCell id="foot" value="&lt;i&gt;Costs assume the AI reviews 100 candidates in depth and writes explanations for the top 20. The search database is billed separately each month (section 4.3).&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=middle;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="120" y="1140" width="700" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>