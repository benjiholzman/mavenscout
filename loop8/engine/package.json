{
  "name": "mavenscout-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node build-tests.mjs && node --test \".test-dist/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "local": "esbuild scripts/run-local.ts --bundle --platform=node --format=esm --packages=external --outfile=.local-dist/run-local.mjs && node .local-dist/run-local.mjs",
    "check-artifact": "esbuild scripts/check-artifact.ts --bundle --platform=node --format=esm --packages=external --outfile=.local-dist/check-artifact.mjs && node .local-dist/check-artifact.mjs",
    "serve": "esbuild scripts/serve-local.ts --bundle --platform=node --format=esm --packages=external --outfile=.local-dist/serve-local.mjs && node .local-dist/serve-local.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "esbuild": "^0.24.0",
    "@types/node": "^22.0.0",
    "@types/aws-lambda": "^8.10.145",
    "adm-zip": "^0.5.16",
    "@types/adm-zip": "^0.5.7"
  }
}
