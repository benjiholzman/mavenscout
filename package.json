{
  "name": "mavenscout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --mode lan",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "baseline": "esbuild scripts/ranking-baseline.ts --bundle --platform=node --format=esm --packages=external --jsx=automatic --log-level=warning --outfile=node_modules/.cache/ranking-baseline.mjs && node node_modules/.cache/ranking-baseline.mjs",
    "demo:snapshot": "esbuild scripts/demo-seed/snapshot.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/demo-snapshot.mjs && node node_modules/.cache/demo-snapshot.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
